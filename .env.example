# Local SQLite (libSQL) database file.
# In production set this to a path on your persistent volume,
# e.g. file:/var/lib/dcfc/db.sqlite
DB_URL=file:./local.sqlite

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" only when the site is served over HTTPS. With this on,
# the session cookie gets the Secure flag and browsers will drop it
# on plain-HTTP requests (which makes admin login appear to fail).
COOKIE_SECURE=false

# Stripe — keys to be provided. Until then the pitch/shop checkout
# routes will throw a clear error so you notice they're unconfigured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Where uploaded images live on disk. Must be writable by the node user.
UPLOADS_DIR=./uploads

# Public URL of the site (used for Stripe success/cancel URLs, OG tags).
PUBLIC_URL=http://localhost:5173

# Resend — email notifications for contact form submissions. If any of
# the three are missing, the contact form still works and messages still
# appear in /admin/messages, but no email goes out.
#   - CONTACT_NOTIFY_TO: staff inbox that receives new-message alerts
#   - CONTACT_NOTIFY_FROM: a verified sender on your Resend domain
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=

# Football Web Pages — fixtures/results sync. The team ID identifies
# Doncaster City on the FWP service (id 3314). With these set the
# admin /admin/fixtures page exposes a "Sync from FWP" button that
# upserts FWP-sourced fixtures into the DB. Manual-source fixtures
# are never touched by the sync.
FWP_API_KEY=
FWP_TEAM_ID=3314
